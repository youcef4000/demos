# En-têtes HTTP des fichiers des démos, appliqués par le serveur du VPS (server/demos.mjs).
# Format : un chemin (« * » = n'importe quelle suite), puis ses en-têtes en retrait. Si plusieurs chemins
# correspondent, leurs en-têtes s'ajoutent ; pour un même en-tête, le dernier l'emporte.
# Hooked Academy a son propre serveur et ses propres en-têtes (server/entetes.mjs).

# Sarraf (carnet vocal du cambiste) : micro autorisé pour l'application seule, API à la même adresse.
/sarraf/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; worker-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=(), usb=()
  X-Robots-Tag: noindex, nofollow
