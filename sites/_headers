# En-têtes HTTP des fichiers statiques (Worker « demos », fichiers de sites/).
# Hooked Academy : pas d'affichage dans un cadre d'un autre site, pas de devinette de type,
# et une politique de contenu (CSP) par page : scripts du site et des bibliothèques précises de cdn.jsdelivr.net.

/hooked-academy/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Cross-Origin-Opener-Policy: same-origin

/hooked-academy/
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net/npm/gsap@3.15.0/ https://cdn.jsdelivr.net/npm/lenis@1.3.26/ https://cdn.jsdelivr.net/npm/three@0.186.1/; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; frame-src 'self'; worker-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'self'; object-src 'none'; frame-ancestors 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

/hooked-academy/index.html
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net/npm/gsap@3.15.0/ https://cdn.jsdelivr.net/npm/lenis@1.3.26/ https://cdn.jsdelivr.net/npm/three@0.186.1/; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; frame-src 'self'; worker-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'self'; object-src 'none'; frame-ancestors 'self'
