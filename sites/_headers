# Sarraf (carnet vocal du cambiste) : micro autorisé pour l'application seule ; l'API peut répondre depuis
# l'adresse de secours du Worker quand le site est servi par le miroir GitHub Pages.
/sarraf/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' https://demos.youcef-ny.workers.dev https://fonts.googleapis.com https://fonts.gstatic.com; worker-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=(), usb=()
  X-Robots-Tag: noindex, nofollow
