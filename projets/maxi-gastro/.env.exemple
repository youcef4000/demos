# Copier en .env (jamais commité) puis remplir. Toutes les clés restent sur le serveur.

# Base de données (SQLite, un seul fichier)
PASSE_BASE=./donnees/passe.sqlite

# Jeton que n8n envoie au serveur du Passe (en-tête Authorization: Bearer …). Générer une longue valeur aléatoire.
PASSE_JETON=
PASSE_PORT=8787

# Shopify — application créée dans le Dev Dashboard de la boutique (droits : produits, inventaire, emplacements)
SHOPIFY_BOUTIQUE=maxigastro.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Ou, pour une ancienne application personnalisée, un jeton d'accès direct :
SHOPIFY_JETON=
SHOPIFY_VERSION_API=2026-10
# Emplacement de stock utilisé pour les produits fournisseurs (gid://shopify/Location/…)
SHOPIFY_EMPLACEMENT=

# Fournisseurs
EQUIPME_CLE=
TEFCOLD_FLUX_XML=
COMBISTEEL_CLE=
DIAMOND_CLE=

# Claude (API Anthropic)
ANTHROPIC_API_KEY=
CLAUDE_MODELE=claude-opus-5-5
