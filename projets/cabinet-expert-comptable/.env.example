# Copier en .env (jamais commité) puis remplir. Aucune clé réelle ici : toutes restent sur le serveur du cabinet.

# Serveur (derrière Caddy pour le HTTPS : garder l'écoute locale)
PORT=8790
HOTE=127.0.0.1
# Dossier des données : base SQLite, pièces déposées, sauvegardes quotidiennes (30 jours)
DONNEES=./donnees
# Cookies « Secure » : 1 en production (HTTPS), 0 seulement pour un essai local en http
SESSION_SECURE=1

# Agents IA
#   desactive  : aucun appel externe, fiches remplies à la main (option A tant que l'ANPDP n'a pas autorisé le transfert)
#   simulation : lecture simulée des pièces d'exemple (présentation)
#   claude     : API Claude (Anthropic), après autorisation de transfert et information des clients
AGENTS=desactive
ANTHROPIC_API_KEY=
CLAUDE_MODELE=claude-opus-5-5
CLAUDE_EFFORT=low

# Messagerie du cabinet (envoi des messages validés dans la boîte d'envoi)
SMTP_HOTE=
SMTP_PORT=465
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
SMTP_EXPEDITEUR="Cabinet <contact@votre-domaine.dz>"
