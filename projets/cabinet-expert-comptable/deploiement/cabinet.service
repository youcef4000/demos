# /etc/systemd/system/cabinet.service — démarre le serveur du cabinet et le relance en cas d'arrêt
[Unit]
Description=Cabinet — site, application et agents
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cabinet
Group=cabinet
WorkingDirectory=/opt/cabinet
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning src/serveur.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
# Durcissement
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/cabinet/donnees

[Install]
WantedBy=multi-user.target
