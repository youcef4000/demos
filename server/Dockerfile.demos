# Image du serveur des démos (demos.bornzstudio.com) : Node seul, aucune dépendance.
# Construite depuis la racine du dépôt par installer-vps.sh. Le dossier sites/ n'est pas copié : il est monté
# depuis le dépôt du VPS (lecture seule), une démo poussée sur main est donc en ligne sans reconstruction.
FROM node:24-bookworm-slim

WORKDIR /app
COPY server ./server

ENV NODE_ENV=production \
    PORT=3000 \
    SITE_DIR=/site \
    TRUST_PROXY=1

USER node
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD node -e "fetch('http://127.0.0.1:3000/sante').then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "server/demos.mjs"]
